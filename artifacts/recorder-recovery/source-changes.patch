-  printf 'capture exceeded 64 MiB bound: %s bytes\n' "$size" >&2
-  exit 4
-fi
-shasum -a 256 "$OUTPUT_FILE"
-cat "$OUTPUT_METRICS"
-printf 'capture_seconds_limit=60 capture_bytes=%s interface=eth1 namespace=%s selection=all-mirrored-frames\n' "$size" "$RECORDER"
